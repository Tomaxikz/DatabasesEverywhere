# Copy to .env next to compose.yml. Compose reads it on every command.

# Required: a reviewed release tag or, preferably, an immutable digest.
DBEV_IMAGE=ghcr.io/tomaxikz/databaseseverywhere:<version>

# Folder holding config.yml, mounted at /etc/databases-everywhere. Relative
# paths resolve against this folder. To keep an existing host install's
# config in place, use /etc/databases-everywhere.
#DBEV_CONFIG_DIR=./config

# Daemon log filter, for example info, debug or databases_everywhere=debug.
#RUST_LOG=info

# Where the healthcheck probes the management API. Match api.host (use
# 127.0.0.1 when it binds 0.0.0.0) and api.port from config.yml.
#DBEV_HEALTHCHECK_HOST=127.0.0.1
#DBEV_HEALTHCHECK_PORT=8090
